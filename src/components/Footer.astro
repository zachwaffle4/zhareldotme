---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Zachary Harel. All rights reserved.
	<div class="social-links">
		<a href="https://github.com/zachwaffle4" target="_blank">
			<span class="sr-only">GitHub Profile</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32" astro-icon="social/github"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path></svg
			>
		</a>
		<a href="mailto:harel.z@northeastern.edu" target="_blank">
			<span class="sr-only">Email</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32" astro-icon="social/email">
				<path
					fill="currentColor"
					d="M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H2zm2.5 3.21l3.1 2.48a1 1 0 0 0 1.2 0L11.5 5.2a.5.5 0 0 1 .8.4v5.4a1 1 0 0 1-1 1h-6.6a1 1 0 0 1-1-1V5.6a.5.5 0 0 1 .8-.39z"
				></path>
			</svg>
		</a>
	</div>
</footer>
<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		width: 900px;
		max-width: calc(100% - 3em);
		margin: 4em auto 0;
		padding: 1.5em 0 3em;
		border-top: 1px solid rgb(var(--border));
		background: none;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		transition: color 0.3s ease, border-color 0.3s ease;
	}
	:global(.dark) footer {
		background: transparent;
		color: rgb(var(--gray));
	}
	.social-links {
		display: flex;
		gap: 1em;
	}
	.social-links svg {
		width: 24px;
		height: 24px;
	}
	@media (max-width: 720px) {
		footer {
			justify-content: center;
			text-align: center;
		}
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>