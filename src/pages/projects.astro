---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { projects, categories } from '../data/projects';

const title = `Projects | ${SITE_TITLE}`;
const description = 'Open-source robotics libraries, FIRST tooling, and embedded software.';

const techCounts = new Map<string, number>();
for (const project of projects) {
	for (const tech of project.tech) {
		techCounts.set(tech, (techCounts.get(tech) ?? 0) + 1);
	}
}
const allTech = [...techCounts.entries()]
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
	.map(([tech]) => tech);

const sections = categories.map((category) => ({
	category,
	projects: projects.filter((p) => p.category === category),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Projects</h1>
			<p class="lead">{description}</p>

			<div class="filters" role="group" aria-label="Filter projects by technology">
				<button type="button" class="chip active" aria-pressed="true" data-tech="">
					All <span class="count">{projects.length}</span>
				</button>
				{
					allTech.map((tech) => (
						<button type="button" class="chip" aria-pressed="false" data-tech={tech}>
							{tech}
						</button>
					))
				}
			</div>

			{
				sections.map((section) => (
					<section data-category>
						<h2 class="section-title">{section.category}</h2>
						<ul class="projects">
							{section.projects.map((project) => (
								<li class="card project" data-tech={project.tech.join('|')}>
									<div class="project-head">
										<h3>{project.name}</h3>
										<span class="meta years">{project.years}</span>
									</div>
									{project.role && <p class="role">{project.role}</p>}
									<p class="blurb">{project.blurb}</p>
									<ul class="tech">
										{project.tech.map((tech) => (
											<li>
												<button type="button" class="tag" data-tech={tech}>
													{tech}
												</button>
											</li>
										))}
									</ul>
									{project.links.length > 0 && (
										<p class="links">
											{project.links.map((link) => (
												<button type="button" class="tag">
													<a href={link.href} target="_blank" rel="noopener">
														{link.label}
													</a>
												</button>
											))}
										</p>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}

			<section>
				<h2 class="section-title">Elsewhere</h2>
				<p>
					More work, including coursework, robotics experiments, and contributions to other
					projects, lives on <a href="https://github.com/zachwaffle4">GitHub</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	// Filter projects by technology. Every card is rendered at build time; this
	// only toggles visibility, so the page still works without JS.
	const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
	const tags = document.querySelectorAll<HTMLButtonElement>('.tag');
	const cards = document.querySelectorAll<HTMLElement>('.project');
	const groups = document.querySelectorAll<HTMLElement>('[data-category]');

	let active = '';

	function apply(tech: string) {
		active = tech === active ? '' : tech;

		for (const card of cards) {
			const techs = (card.dataset.tech ?? '').split('|');
			card.hidden = active !== '' && !techs.includes(active);
		}
		for (const group of groups) {
			group.hidden = group.querySelectorAll('.project:not([hidden])').length === 0;
		}
		for (const chip of chips) {
			const on = (chip.dataset.tech ?? '') === active;
			chip.classList.toggle('active', on);
			chip.setAttribute('aria-pressed', String(on));
		}
		for (const tag of tags) {
			tag.classList.toggle('on', active !== '' && (tag.dataset.tech ?? '') === active);
		}
	}

	for (const button of [...chips, ...tags]) {
		button.addEventListener('click', () => apply(button.dataset.tech ?? ''));
	}
</script>

<style>
	main {
		margin: auto;
		padding: 3rem 1rem;
		width: 860px;
		max-width: calc(100% - 2rem);
		line-height: 1.6;
	}
	h1 {
		margin-bottom: 0.3em;
	}
	.lead {
		font-size: 1.15rem;
		color: rgb(var(--gray-dark));
		margin-bottom: 2rem;
	}
	section {
		margin: 3rem 0;
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.3em 0.9em;
		border: 1px solid rgb(var(--border));
		border-radius: 999px;
		background: rgba(var(--surface), 0.6);
		color: rgb(var(--gray-dark));
		font: inherit;
		font-size: 0.85rem;
		cursor: pointer;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}
	.chip:hover {
		border-color: var(--accent);
		color: rgb(var(--black));
	}
	.chip.active {
		border-color: var(--accent);
		background: var(--accent);
		color: white;
	}
	.count {
		opacity: 0.7;
		font-variant-numeric: tabular-nums;
	}
	ul.projects {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.project-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.project h3 {
		margin: 0;
		font-size: 1.15rem;
	}
	.years {
		flex-shrink: 0;
	}
	.role {
		margin: 0.15em 0 0;
		font-size: 0.95rem;
		font-style: italic;
		color: rgb(var(--gray));
	}
	.blurb {
		margin: 0.6em 0 0;
		font-size: 0.98rem;
	}
	ul.tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0.9em 0 0;
		padding: 0;
	}
	.tag {
		padding: 0.1em 0.6em;
		border: 1px solid transparent;
		border-radius: 999px;
		background: rgba(var(--gray-light), 0.7);
		color: rgb(var(--gray-dark));
		font: inherit;
		font-size: 0.8rem;
		cursor: pointer;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}
	.tag:hover {
		border-color: var(--accent);
		color: rgb(var(--black));
	}
	.tag.on {
		background: var(--accent);
		color: white;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0.8em 0 0;
		font-size: 0.9rem;
	}
	@media (max-width: 720px) {
		.project-head {
			flex-direction: column;
			gap: 0.1rem;
		}
	}
</style>
