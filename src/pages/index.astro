---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const currentWork = [
	{
		title: 'NU Satellite Laboratory',
		text: 'Software development for small satellites, including low-level board-to-board communication.',
	},
	{
		title: 'Open-source robotics',
		text: 'Contributing kinematics and motion planning to WPILib, and maintaining NextFTC.',
	},
	{
		title: 'FIRST Technical Advisor',
		text: 'Running qualifiers and championship tournaments across Massachusetts.',
	},
];

const interests = [
	{
		title: 'Bioinformatics & Computational Biology',
		text: 'Applying computational methods to biological problems.',
	},
	{
		title: 'Machine Learning',
		text: 'Deep learning with PyTorch, and LLM-backed applications.',
	},
	{
		title: 'Robotics & Controls',
		text: 'Motion planning, kinematics, and control theory.',
	},
	{
		title: 'Software Engineering',
		text: 'Full-stack development and open-source contribution.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">CS &amp; Biology @ Northeastern</p>
				<h1>Hi, I'm Zachary Harel</h1>
				<p class="lead">
					I work at the intersection of technology and life sciences — machine learning,
					robotics, and bioinformatics.
				</p>
				<p class="cta">
					<a class="btn primary" href="/projects/">See my projects</a>
					<a class="btn" href="/blog/">Read the blog</a>
					<a class="btn" href="/about/">About me</a>
				</p>
			</section>

			<section>
				<h2 class="section-title">Welcome</h2>
				<p>
					I'm a student in the John Martinson Honors Program at Northeastern University,
					pursuing a dual degree in Computer Science and Biology. My interests lie at the
					intersection of technology and life sciences, with a focus on computational biology,
					machine learning, and robotics.
				</p>
			</section>

			<section>
				<h2 class="section-title">Current Work</h2>
				<ul class="card-grid">
					{
						currentWork.map((item) => (
							<li class="card">
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2 class="section-title">Areas of Interest</h2>
				<ul class="card-grid">
					{
						interests.map((item) => (
							<li class="card">
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>

			<section class="contact card">
				<h2>Get in Touch</h2>
				<p>
					Feel free to reach out if you'd like to discuss research opportunities, internships,
					or collaborations in bioinformatics, computational biology, or software engineering.
				</p>
				<p class="cta">
					<a class="btn primary" href="mailto:harel.z@northeastern.edu">Email me</a>
					<a class="btn" href="https://github.com/zachwaffle4">GitHub</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		margin: auto;
		padding: 3rem 1rem;
		width: 860px;
		max-width: calc(100% - 2rem);
		line-height: 1.6;
	}
	.hero {
		padding-bottom: 1rem;
	}
	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin-bottom: 0.4em;
	}
	.lead {
		max-width: 34em;
		font-size: 1.2rem;
		color: rgb(var(--gray-dark));
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}
	section {
		margin: 3rem 0;
	}
	.card h3 {
		margin-bottom: 0.35rem;
		font-size: 1.1rem;
	}
	.card p {
		margin: 0;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
	}
	.contact {
		padding: 2rem;
	}
	.contact h2 {
		margin-bottom: 0.5rem;
		font-size: 1.35rem;
	}
	.contact p {
		margin-bottom: 0;
	}
	.contact:hover {
		border-color: rgb(var(--border));
		box-shadow: none;
	}
</style>
