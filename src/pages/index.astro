---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Zachary Harel</h1>
			<p class="lead">
				CS & Biology student at Northeastern University passionate about machine learning, robotics, and bioinformatics.
			</p>

			<section>
				<h2>Welcome</h2>
				<p>
					I'm a student in the John Martinson Honors Program at Northeastern University, pursuing a dual degree
					in Computer Science and Biology. My interests lie at the intersection of technology and life sciences,
					with a focus on computational biology, machine learning, and robotics.
				</p>
			</section>

			<section>
				<h2>Current Work</h2>
				<ul>
					<li>Software development for small satellites at NU Satellite Laboratory</li>
					<li>Contributing to open-source robotics libraries (WPILib, NextFTC)</li>
					<li>Technical advisor for FIRST Robotics competitions</li>
				</ul>
			</section>

			<section>
				<h2>Areas of Interest</h2>
				<ul>
					<li><strong>Bioinformatics & Computational Biology:</strong> Applying computational methods to biological problems</li>
					<li><strong>Machine Learning:</strong> Deep learning with PyTorch, LLM applications</li>
					<li><strong>Robotics & Controls:</strong> Motion planning, kinematics, control theory</li>
					<li><strong>Software Engineering:</strong> Full-stack development, open-source contributions</li>
				</ul>
			</section>

			<section>
				<h2>Get in Touch</h2>
				<p>
					Feel free to reach out if you'd like to discuss research opportunities, internships, or collaborations
					in bioinformatics, computational biology, or software engineering.
				</p>
				<p>
					<a href="mailto:harel.z@northeastern.edu">Email</a> |
					<a href="https://github.com/zachwaffle4">GitHub</a> |
					<a href="/about">About Me</a> |
					<a href="/blog">Blog</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		margin: auto;
		padding: 1rem;
		width: 800px;
		max-width: calc(100% - 2rem);
		font-size: 20px;
		line-height: 1.6;
	}
	h1 {
		font-size: 2.5rem;
		font-weight: 700;
		line-height: 1;
		margin-bottom: 0.5em;
	}
	.lead {
		font-size: 1.25rem;
		color: rgb(var(--gray-dark));
		margin-bottom: 2rem;
	}
	section {
		margin-top: 2rem;
		margin-bottom: 2rem;
	}
	section h2 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}
	section ul {
		margin-left: 1.5rem;
	}
	section li {
		margin-bottom: 0.5rem;
	}
</style>