---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const title = `Blog | ${SITE_TITLE}`;
const description = 'Writing on robotics, controls, and software.';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			<p class="lead">{description}</p>

			{
				featured && (
					<a class="featured card" href={`/blog/${featured.id}/`}>
						{featured.data.heroImage && (
							<img
								class="cover"
								width={960}
								height={480}
								src={featured.data.heroImage}
								alt=""
								loading="eager"
							/>
						)}
						<div class="body">
							<p class="meta">
								<FormattedDate date={featured.data.pubDate} /> · Latest
							</p>
							<h2>{featured.data.title}</h2>
							<p class="description">{featured.data.description}</p>
						</div>
					</a>
				)
			}

			{
				rest.length > 0 && (
					<ul class="posts">
						{rest.map((post) => (
							<li>
								<a class="card" href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<img
											class="cover"
											width={720}
											height={360}
											src={post.data.heroImage}
											alt=""
											loading="lazy"
										/>
									)}
									<div class="body">
										<p class="meta">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3>{post.data.title}</h3>
										<p class="description">{post.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				)
			}

			{posts.length === 0 && <p>No posts yet — check back soon.</p>}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		margin: auto;
		padding: 3rem 1rem;
		width: 900px;
		max-width: calc(100% - 2rem);
		line-height: 1.6;
	}
	h1 {
		margin-bottom: 0.3em;
	}
	.lead {
		font-size: 1.15rem;
		color: rgb(var(--gray-dark));
		margin-bottom: 2.5rem;
	}
	.card {
		display: block;
		padding: 0;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
	}
	.cover {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 1;
		/* Post heroes are often screenshots — contain avoids cropping content. */
		object-fit: contain;
		background: rgba(var(--gray-light), 0.15);
		border-radius: 0;
		border-bottom: 1px solid rgb(var(--border));
	}
	.body {
		padding: 1.25rem 1.5rem;
	}
	.body h2,
	.body h3 {
		margin: 0.15em 0 0.35em;
		transition: color 0.2s ease;
	}
	.card:hover h2,
	.card:hover h3 {
		color: var(--accent);
	}
	.meta {
		margin: 0;
	}
	.description {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.98rem;
	}
	.featured {
		margin-bottom: 2rem;
	}
	/* The featured cover gets its natural height so wide screenshots stay legible. */
	.featured .cover {
		aspect-ratio: auto;
		background: none;
	}
	/* Grid covers crop to a shared ratio so the cards line up. */
	.posts .cover {
		object-fit: cover;
		background: none;
	}
	.featured h2 {
		font-size: 1.9rem;
	}
	.posts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.posts .card {
		height: 100%;
	}
</style>
